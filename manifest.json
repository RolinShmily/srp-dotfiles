      "lazygit"
    ],
    "npmGlobals": [
      "@earendil-works/pi-coding-agent",
      "@antfu/ni",
      "live-server"
    ],
    "pythonManager": "uv",
    "skillsAdd": [],
    "piExtensions": [
      "ask-u-questions.ts",
      "continue-signal.ts",
      "prompt-snipaste.ts",
      "srp-theme.ts",
      "tui-asr.ts",
      "web-reach.ts",
      "model-vision.ts",
      "screenshot.ts",
      "custom-providers",
      "subagent",
      "image-generate.ts",
      "memory-log",
      "oai-subquota.ts",
      "windows-wheel-fix.ts"
    ],
    "piPackages": [
      "npm:@upstash/context7-pi",
      "npm:@narumitw/pi-btw",
      "npm:pi-antigravity",
      "npm:pi-wakatime",
      "https://github.com/cathrynlavery/diagram-design"
    ],
    "configs": [
      {
        "name": "vimrc",
        "method": "copy",
        "source": "vim/vimrc",
        "target": "~/_vimrc"
      },
      {
        "name": "wezterm-bg",
        "method": "copy",
        "source": "wezterm/background.png",
        "target": "~/.config/wezterm/background.png"
      },
      {
        "name": "wezterm-conf",
        "method": "copy",
        "source": "wezterm/wezterm.lua",
        "target": "~/.config/wezterm/wezterm.lua"
      },
      {
        "name": "powershell",
        "method": "copy",
        "source": "powershell/profile.ps1",
        "target": "$PROFILE"
      },
      {
        "name": "zellij",
        "method": "copy",
        "source": "zellij",
        "target": "%APPDATA%/Zellij/config"
      },
      {
        "name": "yazi",
        "method": "copy",
        "source": "yazi",
        "target": "%APPDATA%/yazi/config"
      },
      {
        "name": "fastfetch",
        "method": "copy",
        "source": "fastfetch",
        "target": "~/.config/fastfetch"
      },
      {
        "name": "btop-persist-conf",
        "method": "copy",
        "source": "btop/btop.conf",
        "target": "$SCOOP/persist/btop/btop.conf",
        "when": "$SCOOP/persist/btop"
      },
      {
        "name": "btop-persist-themes",
        "method": "copy",
        "source": "btop/themes",
        "target": "$SCOOP/persist/btop/themes",
        "when": "$SCOOP/persist/btop"
      },
      {
        "name": "code-resources",
        "method": "copy",
        "source": "code",
        "exclude": [
          "settings.json.example"
        ],
        "target": "~/.config/code"
      },
      {
        "name": "code-settings",
        "method": "copy",
        "source": "code/settings.json.example",
        "target": "%APPDATA%/Code/User/settings.json"
      },
      {
        "name": "windows-terminal-settings",
        "method": "custom",
        "when": "%LOCALAPPDATA%/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState"
      },
      {
        "name": "pi",
        "method": "custom"
      }
    ]
  }
