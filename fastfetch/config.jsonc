{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "   User      ",
      "keyColor": "green",
      "color": {
        "user": "green",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "custom",
      "format": "  \u001b[36m󰛄 Entities should not be multiplied unnecessarily.\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "  󰣇 OS        ",
      "keyColor": "red"
    },
    {
      "type": "host",
      "key": "  󰌢 Host      ",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "   Kernel    ",
      "keyColor": "red"
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime    ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "   Packages  ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "wm",
      "key": "   WM        ",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "   Terminal  ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "   Shell     ",
      "keyColor": "magenta"
    },
    {
      "type": "display",
      "key": "  󰍹 Display   ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "cpu",
      "key": "   CPU       ",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "   GPU       ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "   Memory    ",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk      ",
      "keyColor": "cyan",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
