{
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "srpTheme": {
    "header": true,
    "footer": true,
    "tps": true
  },
  "srpAsk": {
    "enabled": true
  },
  "srpContinue": {
    "enabled": true,
    "shortcuts": [
      "alt+c"
    ]
  },
  "srpPrompt": {
    "enabled": true,
    "shortcuts": [
      "alt+s"
    ]
  },
  "srpWeb": {
    "search": true,
    "fetch": true
  },
  "srpVision": {
    "enabled": false
  },
  "srpImage": {
    "tool": true,
    "model": "google/gemini-3.1-flash-image",
    "outputDir": ".pi/generated-images"
  },
  "srpVoice": {
    "enabled": true,
    "provider": "auto",
    "model": "paraformer-realtime-v2",
    "language": "zh",
    "shortcuts": [
      "alt+m"
    ],
    "cancelShortcuts": [
      "alt+n"
    ]
  },
  "wslScreenshot": {
    "enabled": true
  },
  "srpSubagent": {
    "enabled": true,
    "mux": "auto",
    "statusWidget": true
  },
  "srpMemory": {
    "default_enabled": false,
    "chunkTokens": 20000,
    "poolTargetTokens": 20000,
    "consolidateAtPoolTokens": 25000,
    "compactAtContextTokens": 250000,
    "tailTokens": 30000,
    "journeyTargetTokens": 2000,
    "observerConcurrency": 4,
    "models": {
      "observer": {
        "thinking": "low"
      },
      "consolidator": {
        "thinking": "medium"
      }
    }
  },
  "terminal": {
    "images": "false"
  },
  "packages": []
}
