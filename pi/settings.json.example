{
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "srpTheme": {
    "header": true,
    "footer": true,
    "tps": true
  },
  "srpAsk": {
    "enabled": true
  },
  "srpContinue": {
    "enabled": true,
    "shortcuts": ["alt+c"],
    "prompt": "请继承并检查历史上下文，从中断处继续完成未完成的工作。"
  },
  "srpPrompt": {
    "enabled": true,
    "shortcuts": ["alt+s"]
  },
  "srpWeb": {
    "search": true,
    "fetch": true
  },
  "srpVision": {
    "enabled": false
  },
  "srpImage": {
    "tool": true,
    "model": "google/gemini-3.1-flash-image",
    "outputDir": ".pi/generated-images"
  },
  "srpVoice": {
    "enabled": true,
    "provider": "auto",
    "model": "",
    "apiKey": "",
    "language": "zh",
    "shortcuts": ["alt+m"],
    "cancelShortcuts": ["alt+n"]
  },
  "wslScreenshot": {
    "enabled": false
  },
  "srpSubagent": {
    "enabled": true,
    "mux": "auto",
    "statusWidget": true
  },
  "srpMemory": {
    "default_enabled": true,
    "chunkTokens": 10000,
    "poolTargetTokens": 10000,
    "consolidateAtPoolTokens": 15000,
    "compactAtContextTokens": 150000,
    "tailTokens": 20000,
    "journeyTargetTokens": 1000,
    "observerConcurrency": 4,
    "models": {
      "observer": { "thinking": "low" },
      "consolidator": { "thinking": "medium" }
    }
  },
  "packages": []
}
