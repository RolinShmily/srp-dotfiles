{
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "memoryLog": {
    "defaultEnabled": false,
    "chunkTokens": 20000,
    "poolTargetTokens": 20000,
    "consolidateAtPoolTokens": 25000,
    "compactAtContextTokens": 250000,
    "tailTokens": 30000,
    "journeyTargetTokens": 2000,
    "observerConcurrency": 4,
    "models": {
      "observer": {
        "thinking": "low"
      },
      "consolidator": {
        "thinking": "medium"
      }
    }
  },
  "packages": [
    "npm:@upstash/context7-pi",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-usage",
    "npm:pi-antigravity",
    "npm:pi-web-access",
    "npm:pi-wakatime",
    "npm:@rol1n/pi-kit"
  ]
}
