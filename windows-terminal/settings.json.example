{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",

    // =========================================================================
    // 1. 自定义动作与协议补丁 (Actions & Protocol Patches)
    // =========================================================================
    "actions": 
    [
        // 【关键修复】将 Pi 拓展所需的 Alt 组合键映射为 CSI-u 转义序列
        // 背景: Zellij 0.40+ 启用了 Kitty Keyboard Protocol，内层 CLI (如 Pi) 强依赖 CSI-u 格式识别 Alt 组合键。
        // 传统 ESC 前缀模式下 \x1b + 字母 会被终端协议层当作控制序列吞掉，例如:
        //   \x1b c = ECMA-48 RIS (Reset to Initial State)
        //   \x1b n = ECMA-48 LS2 (Locking Shift 2)
        //   \x1b s = ANSI SCP  (Save Cursor Position)
        // CSI-u 格式: \x1b[<ascii>;3u (3 = Alt modifier)，可被 Zellij 正确透穿到 Pi。
        //
        // Alt+v (118) → Pi clipboard.pasteImage 粘贴截图
        { "command": { "action": "sendInput", "input": "\u001b[118;3u" }, "id": "User.sendInput.AltV" },
        // Alt+c  (99) → Pi continue-signal 恢复中断的 agent 工作
        { "command": { "action": "sendInput", "input": "\u001b[99;3u"  }, "id": "User.sendInput.AltC" },
        // Alt+m (109) → Pi tui-asr 开始/停止语音听写
        { "command": { "action": "sendInput", "input": "\u001b[109;3u" }, "id": "User.sendInput.AltM" },
        // Alt+n (110) → Pi tui-asr 取消当前听写
        { "command": { "action": "sendInput", "input": "\u001b[110;3u" }, "id": "User.sendInput.AltN" },
        // Alt+s (115) → Pi prompt-snipaste 打开 Prompt 片段选择器
        { "command": { "action": "sendInput", "input": "\u001b[115;3u" }, "id": "User.sendInput.AltS" }
    ],

    // =========================================================================
    // 2. 窗口与启动布局 (Window & Launch Layout)
    // =========================================================================
    "centerOnLaunch": true,
    "initialCols": 120,
    "initialRows": 30,
    "launchMode": "default",
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultInputScope": "alphanumericHalfWidth",

    // 默认配置文件 GUID (指向下方的 PowerShell 7 Core)
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",

    // =========================================================================
    // 3. 快捷键策略 (Keybindings)
    // =========================================================================
    "keybindings": 
    [
        // Pi 拓展 Alt 组合键 → CSI-u 透穿绑定
        { "id": "User.sendInput.AltV", "keys": "alt+v" },
        { "id": "User.sendInput.AltC", "keys": "alt+c" },
        { "id": "User.sendInput.AltM", "keys": "alt+m" },
        { "id": "User.sendInput.AltN", "keys": "alt+n" },
        { "id": "User.sendInput.AltS", "keys": "alt+s" },
        // 基础剪贴板与查找
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.FindText",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        },

        // 【防抢占解绑】显式解绑 Alt + 方向键
        // 背景: 终端复用器 (Zellij / Tmux) 已全权接管分屏，解绑外层 Windows Terminal
        // 的分屏导航，防止拦截命令行 (PowerShell / Zsh / Pi) 中按词跳跃 (Word Navigation)。
        {
            "id": null,
            "keys": "alt+left"
        },
        {
            "id": null,
            "keys": "alt+right"
        },
        {
            "id": null,
            "keys": "alt+up"
        },
        {
            "id": null,
            "keys": "alt+down"
        }
    ],

    "newTabMenu": 
    [
        {
            "type": "remainingProfiles"
        }
    ],

    // =========================================================================
    // 4. 外观与终端配置文件 (Profiles & Appearance)
    // =========================================================================
    "profiles": 
    {
        // 全局通用外观 (所有 Shell 统一继承)
        "defaults": 
        {
            "backgroundImage": "desktopWallpaper",
            "backgroundImageOpacity": 0.07,
            "colorScheme": "One Half Dark",
            "font": 
            {
                "face": "Maple Mono NF CN"
            },
            "opacity": 93,
            "useAcrylic": true
        },
        "list": 
        [
            {
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "hidden": false,
                "name": "PowerShell",
                "source": "Windows.Terminal.PowershellCore"
            },
            {
                "guid": "{7a4326af-b528-59a0-9155-4b9e2772f56b}",
                "hidden": false,
                "name": "WSL",
                "source": "Microsoft.WSL"
            },
            {
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "hidden": false,
                "name": "Command Prompt"
            },
            {
                "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "hidden": false,
                "name": "Windows PowerShell"
            },
            {
                "guid": "{b453ae62-4e3d-5e58-b989-0a998ec441b8}",
                "hidden": false,
                "name": "Azure Cloud Shell",
                "source": "Windows.Terminal.Azure"
            }
        ]
    },
    "schemes": [],
    "themes": []
}
