# configs/zsh/zshrc - Dotfiles 模块化 Zsh 配置主入口 (部署至 ~/.zshrc)

# ------------------------------------------------------------------
# 1. 解析配置模块目录
#    安装器把模块复制到 ~/.config/srp-dotfiles/zsh，所以即使 ~/.zshrc 是
#    复制品（而非软链接），配置也能独立工作，不依赖仓库 clone。
# ------------------------------------------------------------------
if [ -n "$ZSH_DOTFILES_DIR" ]; then
    # 显式覆盖：ZSH_DOTFILES_DIR 指向仓库根
    DOTFILES_DIR="$ZSH_DOTFILES_DIR"
    DOTFILES_CONFIG="$DOTFILES_DIR/configs"
elif [ -d "$HOME/.config/srp-dotfiles/zsh" ]; then
    DOTFILES_CONFIG="$HOME/.config/srp-dotfiles"
elif [ -d "${${(%):-%N}:A:h:h:h}/configs/zsh" ]; then
    # 软链接部署，或直接 source 仓库内的 zshrc
    DOTFILES_DIR="${${(%):-%N}:A:h:h:h}"
    DOTFILES_CONFIG="$DOTFILES_DIR/configs"
elif [ -d "$HOME/.srp-dotfiles/configs/zsh" ]; then
    # install.sh 在线安装的默认克隆位置
    DOTFILES_DIR="$HOME/.srp-dotfiles"
    DOTFILES_CONFIG="$DOTFILES_DIR/configs"
elif [ -d "$HOME/.dotfiles/configs/zsh" ]; then
    DOTFILES_DIR="$HOME/.dotfiles"
    DOTFILES_CONFIG="$DOTFILES_DIR/configs"
elif [ -d "$HOME/Projects/dotfiles/configs/zsh" ]; then
    DOTFILES_DIR="$HOME/Projects/dotfiles"
    DOTFILES_CONFIG="$DOTFILES_DIR/configs"
else
    # 都没有时仍指向部署位置，让下面的 -f 检查安静地跳过
    DOTFILES_CONFIG="$HOME/.config/srp-dotfiles"
fi

export DOTFILES_CONFIG
if [ -n "$DOTFILES_DIR" ]; then
    export DOTFILES_DIR
fi

# ------------------------------------------------------------------
# 2. 按顺序加载通用模块
# ------------------------------------------------------------------
_generic_modules=(
    env
    omz
    git
    aliases
    tools
)

for _mod in "${_generic_modules[@]}"; do
    if [ -f "$DOTFILES_CONFIG/zsh/${_mod}.zsh" ]; then
        source "$DOTFILES_CONFIG/zsh/${_mod}.zsh"
    fi
done
unset _mod _generic_modules

# ------------------------------------------------------------------
# 3. 动态识别操作系统并加载特供模块
# ------------------------------------------------------------------
_detect_os_module() {
    if [ -d "/data/data/com.termux" ]; then
        echo "termux"
    elif [ -f /etc/os-release ]; then
        if grep -qi "arch" /etc/os-release; then
            echo "arch"
        elif grep -qiE "debian|ubuntu" /etc/os-release; then
            echo "debian"
        elif grep -qi "fedora" /etc/os-release; then
            echo "fedora"
        else
            echo "arch"
        fi
    elif [ -f /etc/arch-release ]; then
        echo "arch"
    elif [ -f /etc/debian_version ]; then
        echo "debian"
    elif [ -f /etc/fedora-release ]; then
        echo "fedora"
    else
        echo "arch"
    fi
}

_CURRENT_OS="$(_detect_os_module)"
if [ -f "$DOTFILES_CONFIG/zsh/os/${_CURRENT_OS}.zsh" ]; then
    source "$DOTFILES_CONFIG/zsh/os/${_CURRENT_OS}.zsh"
fi
unset _CURRENT_OS _detect_os_module

# ------------------------------------------------------------------
# 4. 加载单机专属私有配置（不入 Git 仓库，可存放私有 Token/密钥）
#    部署模式下受管目录 ~/.config/srp-dotfiles/zsh 每次都会被整体替换，
#    私有文件请放在它外面（~/.config/srp-dotfiles/local.zsh 或 ~/.zshrc.local）。
# ------------------------------------------------------------------
if [ -f "$HOME/.config/srp-dotfiles/local.zsh" ]; then
    source "$HOME/.config/srp-dotfiles/local.zsh"
fi
if [ -f "$DOTFILES_CONFIG/zsh/local.zsh" ]; then
    source "$DOTFILES_CONFIG/zsh/local.zsh"
fi
if [ -f "$HOME/.zshrc.local" ]; then
    source "$HOME/.zshrc.local"
fi
