{
  "wingetPackages": [
    "Microsoft.PowerShell",
    "Git.Git",
    "GitHub.cli",
    "Fastfetch-cli.Fastfetch",
    "sxyazi.yazi",
    "7zip.7zip",
    "jqlang.jq",
    "sharkdp.fd",
    "BurntSushi.ripgrep.MSVC",
    "junegunn.fzf",
    "ajeetdsouza.zoxide",
    "ImageMagick.ImageMagick",
    "sharkdp.bat",
    "tldr-pages.tlrc",
    "JanDeDobbeleer.OhMyPosh",
    "Gyan.FFmpeg",
    "oschwartz10612.Poppler",
    "Tailscale.Tailscale"
  ],
  "scoopPackages": [
    "curl",
    "aria2",
    "nodejs-lts",
    "uv",
    "vim",
    "sox",
    "eza",
    "lazygit",
    "btop",
    "zellij",
    "notepad3",
    "vscode"
  ],
  "npmGlobals": [
    "@earendil-works/pi-coding-agent",
    "@antfu/ni",
    "live-server"
  ],
  "skillsAdd": [],
  "scripts": [
    {
      "name": "herdr-core",
      "url": "https://releases.herdr.dev/core/install.ps1",
      "shell": "powershell"
    },
    {
      "name": "herdr-tui",
      "url": "https://herdr.dev/install.ps1",
      "shell": "powershell"
    }
  ],
  "configs": [
    {
      "name": "vimrc",
      "source": "configs/vim/vimrc",
      "target": "~/_vimrc"
    },
    {
      "name": "powershell",
      "source": "configs/powershell/profile.ps1",
      "target": "$PROFILE"
    },
    {
      "name": "zellij",
      "source": "configs/zellij",
      "target": "%APPDATA%/Zellij/config"
    },
    {
      "name": "yazi",
      "source": "configs/yazi",
      "target": "%APPDATA%/yazi/config"
    },
    {
      "name": "fastfetch",
      "source": "configs/fastfetch",
      "target": "~/.config/fastfetch"
    },
    {
      "name": "btop-persist-conf",
      "source": "configs/btop/btop-win.conf",
      "target": "$SCOOP/persist/btop/btop.conf",
      "when": "$SCOOP/persist/btop"
    },
    {
      "name": "btop-persist-themes",
      "source": "configs/btop/themes",
      "target": "$SCOOP/persist/btop/themes",
      "when": "$SCOOP/persist/btop"
    },
    {
      "name": "code-resources",
      "source": "configs/code",
      "exclude": [
        "settings.json"
      ],
      "target": "~/.config/code"
    },
    {
      "name": "code-settings",
      "source": "configs/code/settings.json",
      "target": "%APPDATA%/Code/User/settings.json"
    },
    {
      "name": "pi",
      "source": "configs/pi",
      "target": "~/.pi/agent"
    }
  ],
  "fonts": [
    "Maple-Mono-NF-CN",
    "Inter",
    "SourceHanSansSC"
  ]
}
