{
  "packageManagers": [
    "winget",
    "scoop"
  ],
  "wingetPackages": [
    "Microsoft.PowerShell",
    "Git.Git",
    "JanDeDobbeleer.OhMyPosh",
    "GitHub.cli",
    "Fastfetch-cli.Fastfetch",
    "sxyazi.yazi",
    "Gyan.FFmpeg",
    "7zip.7zip",
    "jqlang.jq",
    "oschwartz10612.Poppler",
    "sharkdp.fd",
    "BurntSushi.ripgrep.MSVC",
    "junegunn.fzf",
    "ajeetdsouza.zoxide",
    "ImageMagick.ImageMagick",
    "sharkdp.bat",
    "tldr-pages.tlrc"
  ],
  "scoopBuckets": [
    "main = https://mirror.nju.edu.cn/git/scoop-main.git",
    "extras = https://mirror.nju.edu.cn/git/scoop-extras.git",
    "versions = https://mirror.nju.edu.cn/git/scoop-versions.git",
    "nerd-fonts = https://mirror.nju.edu.cn/git/scoop-nerd-fonts.git/",
    "dorado = https://github.com/chawyehsu/dorado"
  ],
  "scoopPackages": [
    "aria2",
    "vim",
    "nodejs-lts",
    "sox",
    "curl",
    "Maple-Mono-NF-CN",
    "btop",
    "zellij",
    "notepad3",
    "vscode",
    "eza",
    "uv",
    "lazygit"
  ],
  "npmGlobals": [
    "@earendil-works/pi-coding-agent",
    "@antfu/ni",
    "live-server"
  ],
  "pythonManager": "uv",
  "skillsAdd": [
    "tt-a1i/archify"
  ],
  "configs": [
    {
      "name": "vimrc",
      "method": "copy",
      "source": "vim/vimrc",
      "target": "~/_vimrc"
    },
    {
      "name": "wezterm-bg",
      "method": "copy",
      "source": "wezterm/background.png",
      "target": "~/.config/wezterm/background.png"
    },
    {
      "name": "wezterm-conf",
      "method": "copy",
      "source": "wezterm/wezterm.lua",
      "target": "~/.config/wezterm/wezterm.lua"
    },
    {
      "name": "powershell",
      "method": "copy",
      "source": "powershell/profile.ps1",
      "target": "$PROFILE"
    },
    {
      "name": "zellij",
      "method": "copy",
      "source": "zellij",
      "target": "%APPDATA%/Zellij/config"
    },
    {
      "name": "yazi",
      "method": "copy",
      "source": "yazi",
      "target": "%APPDATA%/yazi/config"
    },
    {
      "name": "fastfetch",
      "method": "copy",
      "source": "fastfetch",
      "target": "~/.config/fastfetch"
    },
    {
      "name": "btop-persist-conf",
      "method": "copy",
      "source": "btop/btop-win.conf",
      "target": "$SCOOP/persist/btop/btop.conf",
      "when": "$SCOOP/persist/btop"
    },
    {
      "name": "btop-persist-themes",
      "method": "copy",
      "source": "btop/themes",
      "target": "$SCOOP/persist/btop/themes",
      "when": "$SCOOP/persist/btop"
    },
    {
      "name": "code-resources",
      "method": "copy",
      "source": "code",
      "exclude": [
        "settings.json.example"
      ],
      "target": "~/.config/code"
    },
    {
      "name": "code-settings",
      "method": "copy",
      "source": "code/settings.json.example",
      "target": "%APPDATA%/Code/User/settings.json"
    },
    {
      "name": "windows-terminal-settings",
      "method": "custom",
      "when": "%LOCALAPPDATA%/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState"
    },
    {
      "name": "pi-agents",
      "method": "copy",
      "source": "pi/AGENTS.md",
      "target": "~/.pi/agent/AGENTS.md"
    },
    {
      "name": "pi-settings",
      "method": "copy",
      "source": "pi/settings.json.example",
      "target": "~/.pi/agent/settings.json"
    },
    {
      "name": "pi-mcp",
      "method": "copy",
      "source": "pi/mcp.json.example",
      "target": "~/.pi/agent/mcp.json"
    },
    {
      "name": "pi-keybindings",
      "method": "copy",
      "source": "pi/keybindings.json.example",
      "target": "~/.pi/agent/keybindings.json"
    },
    {
      "name": "pi-skill-browser-tools",
      "method": "link",
      "source": "pi/skills/browser-tools",
      "target": "~/.pi/agent/skills/browser-tools"
    },
    {
      "name": "pi-skill-gh",
      "method": "link",
      "source": "pi/skills/gh",
      "target": "~/.pi/agent/skills/gh"
    },
    {
      "name": "pi-skill-grill-me",
      "method": "link",
      "source": "pi/skills/grill-me",
      "target": "~/.pi/agent/skills/grill-me"
    },
    {
      "name": "pi-skill-i-have-adhd",
      "method": "link",
      "source": "pi/skills/i-have-adhd",
      "target": "~/.pi/agent/skills/i-have-adhd"
    },
    {
      "name": "pi-skill-skill-creator",
      "method": "link",
      "source": "pi/skills/skill-creator",
      "target": "~/.pi/agent/skills/skill-creator"
    },
    {
      "name": "pi-skill-worktree-studio",
      "method": "link",
      "source": "pi/skills/worktree-studio",
      "target": "~/.pi/agent/skills/worktree-studio"
    }
  ]
}
