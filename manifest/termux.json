{
  "packageManager": "pkg",
  "packages": [
    "zsh",
    "eza",
    "zoxide",
    "curl",
    "fzf",
    "bat",
    "fd",
    "ripgrep",
    "diff-so-fancy",
    "gh",
    "lazygit",
    "jq",
    "tealdeer",
    "nodejs",
    "python",
    "yazi",
    "file",
    "chafa",
    "imagemagick",
    "poppler",
    "ffmpeg",
    "imagemagick",
    "7zip",
    "unar",
    "exiftool",
    "mediainfo",
    "miller",
    "git",
    "clang",
    "make",
    "unzip",
    "tree-sitter",
    "tmux",
    "fastfetch",
    "htop",
    "termux-api"
  ],
  "npmGlobals": [
    "@earendil-works/pi-coding-agent",
    "@antfu/ni",
    "live-server"
  ],
  "skillsAdd": [
    "tt-a1i/archify"
  ],
  "configs": [
    {
      "name": "zshrc",
      "method": "link",
      "source": "zsh/zshrc",
      "target": "~/.zshrc"
    },
    {
      "name": "vimrc",
      "method": "link",
      "source": "vim/vimrc",
      "target": "~/.vimrc"
    },
    {
      "name": "fastfetch",
      "method": "link",
      "source": "fastfetch",
      "target": "~/.config/fastfetch"
    },
    {
      "name": "yazi",
      "method": "link",
      "source": "yazi",
      "target": "~/.config/yazi"
    },
    {
      "name": "tmux",
      "method": "link",
      "source": "tmux",
      "target": "~/.config/tmux"
    },
    {
      "name": "pi",
      "method": "custom"
    }
  ],
  "piResources": {
    "packages": [],
    "extensions": [],
    "skills": [
      "@repo/pi/skills"
    ],
    "prompts": []
  }
}
