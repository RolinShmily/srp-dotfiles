{
  "packageManager": "dnf",
  "copr": [
    "dejan/lazygit"
  ],
  "fonts": [
    "MapleMono-NF-CN"
  ],
  "packages": [
    "zsh",
    "zsh-autosuggestions",
    "zsh-syntax-highlighting",
    "curl",
    "eza",
    "zoxide",
    "fzf",
    "bat",
    "fd-find",
    "ripgrep",
    "diff-so-fancy",
    "gh",
    "lazygit",
    "jq",
    "tldr",
    "nodejs",
    "npm",
    "python3",
    "python3-pip",
    "pipx",
    "uv",
    "file",
    "chafa",
    "ImageMagick",
    "poppler-utils",
    "ffmpeg-free",
    "sox",
    "7zip",
    "unar",
    "perl-Image-ExifTool",
    "mediainfo",
    "zathura",
    "zathura-pdf-poppler",
    "miller",
    "xdg-utils",
    "xclip",
    "wl-clipboard",
    "vim-enhanced",
    "git",
    "unzip",
    "tmux",
    "fastfetch",
    "btop"
  ],
  "npmGlobals": [
    "@earendil-works/pi-coding-agent",
    "@antfu/ni",
    "live-server"
  ],
  "skillsAdd": [
    "tt-a1i/archify",
    "Vincentwei1021/video-shotcraft"
  ],
  "configs": [
    {
      "name": "zshrc",
      "method": "link",
      "source": "zsh/zshrc",
      "target": "~/.zshrc"
    },
    {
      "name": "vimrc",
      "method": "link",
      "source": "vim/vimrc",
      "target": "~/.vimrc"
    },
    {
      "name": "btop-conf",
      "method": "copy",
      "source": "btop/btop-linux.conf",
      "target": "~/.config/btop/btop.conf"
    },
    {
      "name": "btop-themes",
      "method": "link",
      "source": "btop/themes",
      "target": "~/.config/btop/themes"
    },
    {
      "name": "fastfetch",
      "method": "link",
      "source": "fastfetch",
      "target": "~/.config/fastfetch"
    },
    {
      "name": "tmux",
      "method": "link",
      "source": "tmux",
      "target": "~/.config/tmux"
    },
    {
      "name": "pi",
      "method": "custom"
    }
  ],
  "piResources": {
    "packages": [],
    "extensions": [],
    "skills": [
      "@repo/pi/skills"
    ],
    "prompts": []
  }
}
