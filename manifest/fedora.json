{
  "packageManager": "dnf",
  "fonts": [
    "MapleMono-NF-CN",
    "Inter",
    "SourceHanSansSC"
  ],
  "packages": [
    "git",
    "curl",
    "unzip",
    "file",
    "zsh",
    "zsh-autosuggestions",
    "zsh-syntax-highlighting",
    "python3",
    "python3-pip",
    "pipx",
    "uv",
    "nodejs",
    "npm",
    "ripgrep",
    "fd-find",
    "bat",
    "eza",
    "zoxide",
    "fzf",
    "jq",
    "tldr",
    "diff-so-fancy",
    "gh",
    "lazygit",
    "miller",
    "ImageMagick",
    "poppler-utils",
    "ffmpeg-free",
    "sox",
    "chafa",
    "mediainfo",
    "7zip",
    "unar",
    "perl-Image-ExifTool",
    "zathura",
    "zathura-pdf-poppler",
    "vim-enhanced",
    "tmux",
    "fastfetch",
    "btop",
    "xdg-utils",
    "xclip",
    "wl-clipboard"
  ],
  "npmGlobals": [
    "@earendil-works/pi-coding-agent",
    "@antfu/ni",
    "live-server"
  ],
  "skillsAdd": [],
  "scripts": [
    {
      "name": "herdr-core",
      "url": "https://releases.herdr.dev/core/install.sh",
      "shell": "sh"
    },
    {
      "name": "herdr-tui",
      "url": "https://herdr.dev/install.sh",
      "shell": "sh"
    },
    {
      "name": "tailscale",
      "url": "https://raw.githubusercontent.com/tailscale/tailscale/main/scripts/installer.sh",
      "shell": "sh"
    },
    {
      "name": "magpie",
      "url": "https://usemagpie.ai/install.sh",
      "shell": "sh"
    }
  ],
  "configs": [
    {
      "name": "zshrc",
      "source": "configs/zsh/zshrc",
      "target": "~/.zshrc"
    },
    {
      "name": "zsh-modules",
      "source": "configs/zsh",
      "target": "~/.config/srp-dotfiles/zsh",
      "exclude": [
        "zshrc",
        "local.zsh"
      ]
    },
    {
      "name": "vimrc",
      "source": "configs/vim/vimrc",
      "target": "~/.vimrc"
    },
    {
      "name": "btop-conf",
      "source": "configs/btop/btop-linux.conf",
      "target": "~/.config/btop/btop.conf"
    },
    {
      "name": "btop-themes",
      "source": "configs/btop/themes",
      "target": "~/.config/btop/themes"
    },
    {
      "name": "fastfetch",
      "source": "configs/fastfetch",
      "target": "~/.config/fastfetch"
    },
    {
      "name": "tmux",
      "source": "configs/tmux",
      "target": "~/.config/tmux"
    },
    {
      "name": "pi",
      "source": "configs/pi",
      "target": "~/.pi/agent"
    }
  ]
}
