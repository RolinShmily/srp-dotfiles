{
  "packageManager": "apt",
  "packages": [
    "zsh",
    "zsh-autosuggestions",
    "zsh-syntax-highlighting",
    "curl",
    "eza",
    "zoxide",
    "fzf",
    "bat",
    "fd-find",
    "ripgrep",
    "gh",
    "lazygit",
    "jq",
    "tealdeer",
    "nodejs",
    "python3-full",
    "pipx",
    "vim",
    "git",
    "ffmpeg",
    "imagemagick",
    "7zip",
    "build-essential",
    "gcc",
    "unzip",
    "tmux",
    "fastfetch",
    "btop"
  ],
  "npmGlobals": [
    "@earendil-works/pi-coding-agent",
    "@antfu/ni",
    "live-server"
  ],
  "skillsAdd": [
    "tt-a1i/archify"
  ],
  "configs": [
    {
      "name": "zshrc",
      "method": "link",
      "source": "zsh/zshrc",
      "target": "~/.zshrc"
    },
    {
      "name": "vimrc",
      "method": "link",
      "source": "vim/vimrc",
      "target": "~/.vimrc"
    },
    {
      "name": "btop-conf",
      "method": "copy",
      "source": "btop/btop-linux.conf",
      "target": "~/.config/btop/btop.conf"
    },
    {
      "name": "btop-themes",
      "method": "link",
      "source": "btop/themes",
      "target": "~/.config/btop/themes"
    },
    {
      "name": "fastfetch",
      "method": "link",
      "source": "fastfetch",
      "target": "~/.config/fastfetch"
    },
    {
      "name": "tmux",
      "method": "link",
      "source": "tmux",
      "target": "~/.config/tmux"
    },
    {
      "name": "pi",
      "method": "custom"
    }
  ],
  "piResources": {
    "packages": [],
    "extensions": [],
    "skills": [
      "@repo/pi/skills"
    ],
    "prompts": []
  }
}
